# The parts of Rails and its neighbours that `simplecov/affected/rails`
# touches, none of which SimpleCov depends on.
module I18n
  def self.load_path: () -> Array[untyped]
end

module ActiveSupport
  module Notifications
    def self.subscribe: (Regexp pattern) { (*untyped) -> void } -> untyped
  end
end

module ViewComponent
  class Base
  end
end
