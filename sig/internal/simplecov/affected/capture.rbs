module SimpleCov
  module Affected
    module Capture
      extend Capture

      def call: (Recorder recorder, Result result, String root, ?loaded_features: Array[String]) -> Hash[String, untyped]?

      private

      def blank: (String root) -> Hash[String, untyped]

      def record_files: (Hash[String, untyped] document, Hash[String, String] versions, Recorder recorder, Hash[String, untyped] coverage) -> void

      def read_source: (String path) -> String?

      def record_contexts: (Hash[String, untyped] document, Hash[String, String] versions, Recorder recorder, Hash[String, untyped] map) -> void

      def owned_lines: (Hash[String, String] versions, Hash[String, String] latest, Recorder recorder, Hash[String, untyped] map) -> Hash[String, Hash[String, [String, String]]]

      def record_reads: (Hash[String, untyped] document, Recorder recorder, String root) -> void

      def record_unmeasured: (Hash[String, untyped] document, Recorder recorder, Hash[String, untyped] coverage, Array[String] loaded_features) -> void
    end
  end
end
