module SimpleCov
  module Affected
    class Tree
      @files: Recorder
      @texts: Hash[String, String?]
      @versions: Hash[String, Version?]
      @ruby_files: Array[String]

      attr_reader root: String

      def initialize: (String root, String coverage_path) -> void

      def text: (String path) -> String?

      def digest: (String path) -> String?

      def file_digest: (String path) -> String?

      def version: (String path) -> Version?

      def exist?: (String path) -> bool

      def glob: (String pattern) -> Array[String]

      def ruby_files: () -> Array[String]
    end
  end
end
