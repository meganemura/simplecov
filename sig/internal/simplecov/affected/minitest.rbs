module SimpleCov
  module Affected
    module Minitest
      extend Minitest

      SPEC_NUMBER: Regexp

      def install: (untyped test_case, ?narrow: bool) -> void

      def id: (untyped klass, String name) -> String

      def file: (untyped klass, String name) -> String?

      def location: (untyped klass, String name) -> [String, Integer]?

      interface _Test
        def run: () -> untyped

        def name: () -> String

        def class: () -> untyped

        def passed?: () -> bool

        def skipped?: () -> bool
      end

      interface _Runnable
        def run: (*untyped, **untyped) -> untyped

        def filter_runnable_methods: (?untyped options) -> untyped
      end

      module Filters : _Runnable
        NAMES: Array[Symbol]

        def self.note: (untyped options) -> void

        def run: (*untyped args, **untyped kwargs) -> untyped

        def filter_runnable_methods: (?untyped options) -> untyped
      end

      interface _Methods
        def runnable_methods: () -> Array[String]
      end

      module Narrow : _Methods
        def runnable_methods: () -> Array[String]
      end

      module Run : _Test
        def run: () -> untyped
      end
    end
  end
end
