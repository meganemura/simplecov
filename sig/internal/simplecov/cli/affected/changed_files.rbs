module SimpleCov
  module CLI
    module Affected
      module ChangedFiles
        def self?.call: (String base, untyped stderr) -> Hash[Symbol, untyped]?

        def self?.repository_toplevel: (untyped stderr) -> String?

        WHOLE_FILE_CONTEXT: Integer

        CODE_LINE: Regexp

        DEF_LINE: Regexp

        def self?.list: (String command, Array[String] argv, untyped stderr) -> Array[String]?

        def self?.git_output: (String command, Array[String] argv, untyped stderr) -> String?

        def self?.checked_output: ([String?, String, bool] result, String command, untyped stderr) -> String?

        def self?.report_lines_changed: (String root, String base, String path, untyped stderr) -> { source: Array[String], changed: Array[Integer] }?

        def self?.parse_report_lines_changed: (String patch) -> { source: Array[String], changed: Array[Integer] }

        def self?.method_lines: (String source) -> Array[Range[Integer]]?

        def self?.adds_only_methods?: (Range[Integer] added, Array[Range[Integer]]? methods, Array[String] head) -> bool

        def self?.report: (untyped stderr, String message) -> nil
      end
    end
  end
end
