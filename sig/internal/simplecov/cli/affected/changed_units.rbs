module SimpleCov
  module CLI
    module Affected
      module ChangedUnits
        def self?.contexts: (Hash[String, untyped] entry, Hash[Integer, Integer] table, String? current) -> Set[Integer]?

        def self?.recorded_source: (untyped source) -> String?

        def self?.charged_units: (Units::Outline before, Units::Outline after) -> Array[Units::Unit]?

        def self?.recorded_ancestor: (Units::Unit unit, Units::Outline before) -> Units::Unit

        def self?.reached: (Array[Units::Unit] charged, Array[untyped] lines, Hash[Integer, Integer] table) -> Set[Integer]?

        def self?.traceable?: (Units::Unit unit, Array[untyped] lines, Integer covered) -> bool
      end
    end
  end
end
