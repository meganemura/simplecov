module SimpleCov
  module CLI
    module Affected
      module ChangedUnits
        LOAD_TIME: :load_time

        def self?.contexts: (Hash[String, untyped] entry, Hash[Integer, Integer] table, String? current) -> (Set[Integer] | :load_time)?

        def self?.recorded_source: (untyped source) -> String?

        def self?.charged_units: (Units::Outline before, Units::Outline after) -> Array[Units::Unit]?

        def self?.reached: (Array[Units::Unit] charged, Array[untyped] lines, Hash[Integer, Integer] table) -> (Set[Integer] | :load_time)?

        def self?.ran?: (untyped hits) -> bool
      end
    end
  end
end
