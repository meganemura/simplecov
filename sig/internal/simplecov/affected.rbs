module SimpleCov
  module Affected
    extend Affected

    @recorder: Recorder?
    @plan: Plan?
    @mode: Symbol

    attr_reader recorder: Recorder?

    attr_reader plan: Plan?

    def start: () -> void

    def install_minitest: () -> void

    def narrowing?: () -> bool

    def run?: (String id) -> bool

    def settle: () -> void

    def capture: (Result result) -> void

    def finish: () -> void
  end
end
